# Variables para desarrollo local. Copiar a apps/web/.env.local (no se sube al repo).
# Sin DATABASE_URL se usa PGlite en apps/web/.data/pglite: no hace falta Docker ni Postgres.
# DATABASE_URL=postgres://renglon:renglon@127.0.0.1:5433/renglon   # con deploy/docker-compose.dev.yml

# Abre el sitio en http://renglon.localhost:5173 (no en localhost): Wompi rechaza
# volver a "localhost" después del pago, y las cookies de sesión son de este host.
BETTER_AUTH_URL=http://renglon.localhost:5173

# Llaves de Sandbox de Wompi (panel de comercios → Desarrolladores). Ver deploy/.env.example.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Sin SMTP_URL, los correos (enlace mágico, recuperar contraseña) se imprimen en la consola de `pnpm dev`.
# SMTP_URL=

# Muestra recuadros de prueba donde irían los anuncios.
# ADS_PREVIEW=1
