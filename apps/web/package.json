{
  "name": "@pdf-editor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "node scripts/copy-pdfjs-assets.mjs && next dev --port 5173",
    "build": "node scripts/copy-pdfjs-assets.mjs && next build",
    "start": "next start --port 5173",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@pdf-editor/editor-ui": "workspace:*",
    "@pdf-editor/pdf-core": "workspace:*",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "next": "^16.4.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@pdf-editor/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
