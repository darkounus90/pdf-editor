# Copiar a deploy/.env en el servidor y completar.
DOMAIN=renglonpdf.online
ACME_EMAIL=

# Correo de contacto que aparece en Privacidad y Términos.
CONTACT_EMAIL=

# Google AdSense. Vacío = sin anuncios ni ads.txt.
# ADSENSE_CLIENT es el identificador de editor (ca-pub-…); ADSENSE_SLOT, el id de un bloque de anuncios adaptable.
# Al cambiarlos hay que recompilar: docker compose up -d --build
ADSENSE_CLIENT=
ADSENSE_SLOT=
