# Copiar a deploy/.env en el servidor y completar. Nunca subas deploy/.env al repo.
# Después de cambiar algo: docker compose up -d   (o --build si cambias algo de AdSense o CONTACT_EMAIL)
DOMAIN=renglonpdf.online
ACME_EMAIL=

# Correo de contacto que aparece en Privacidad y Términos.
CONTACT_EMAIL=

# Google AdSense. Vacío = sin anuncios ni ads.txt. Los usuarios con plan pago nunca ven anuncios.
# ADSENSE_CLIENT es el identificador de editor (ca-pub-…); ADSENSE_SLOT, el id de un bloque de anuncios adaptable.
# Al cambiarlos hay que recompilar: docker compose up -d --build
ADSENSE_CLIENT=
ADSENSE_SLOT=

# ---------- Base de datos (obligatorio) ----------
# Contraseña del usuario "renglon" de Postgres. Solo letras y números (va dentro de una URL).
# Generar con: openssl rand -hex 24
# No la cambies después de crear la base: Postgres guarda la contraseña en su volumen.
POSTGRES_PASSWORD=

# ---------- Cuentas (Better Auth) ----------
# Secreto para firmar sesiones (obligatorio). Generar con: openssl rand -base64 32
# Si cambia, todas las sesiones se cierran.
BETTER_AUTH_SECRET=

# Inicio de sesión con Google (opcional; vacío = sin botón de Google).
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizado: https://renglonpdf.online/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo saliente (opcional). Activa el enlace mágico, recuperar contraseña y los avisos de vencimiento.
# Formato: smtps://usuario:contraseña@servidor:465   (o smtp://…:587). Vacío = esas funciones se ocultan.
SMTP_URL=
# Remitente, p. ej.: Renglón <hola@renglonpdf.online>
EMAIL_FROM=

# ---------- Pagos con Wompi ----------
# Panel de comercios de Wompi (comercios.wompi.co) → sección de desarrolladores: llaves del API y secretos para integración técnica.
# Para pruebas usa las de Sandbox (pub_test_…, prv_test_…, test_integrity_…, test_events_…);
# en producción, las de Producción (pub_prod_…, prv_prod_…, prod_integrity_…, prod_events_…).
# Sin llave pública, secreto de integridad y secreto de eventos, los botones de compra se desactivan.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# URL de eventos que hay que registrar en el panel de Wompi: https://renglonpdf.online/api/pagos/wompi

# Precios en pesos colombianos, enteros y sin puntos. Vacío = valor por defecto (7900, 16900 y 129000).
PRICE_WEEKLY_COP=
PRICE_PRO_MONTHLY_COP=
PRICE_PRO_YEARLY_COP=

# Límites diarios del plan gratis (hora de Colombia). Vacío = 3 descargas y 60 páginas; FREE_DAILY_PAGES=0 quita el límite de páginas.
FREE_DAILY_DOWNLOADS=
FREE_DAILY_PAGES=

# Clave para el cron diario de avisos de vencimiento (deploy/send-reminders.sh). Generar con: openssl rand -hex 24
CRON_SECRET=
